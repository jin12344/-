{
  "rules": {
    "scores": {
      ".read": true,
      ".write": false,
      "$scoreId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['nickname', 'time', 'timestamp'])",
        "nickname": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10"
        },
        "time": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "admins": {
      ".read": false,
      ".write": false
    }
  }
}
